<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PRCe360_WithLanes" targetNamespace="http://speridian.com/prce360" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.24.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Future State Case Lifecycle" processRef="Process_PRCe360_WithLanes" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PRCe360_WithLanes" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Tier2" name="Tier 2 User">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitFiling</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_AssignNumbers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyDenial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManageCOS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Records" name="Records Division">
        <bpmn:flowNodeRef>Task_IntakeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApproveDeny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RouteCase</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LU" name="Enforcement Division">
        <bpmn:flowNodeRef>Task_JurisdictionalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LU_DraftOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OGC" name="Compliance Examiners">
        <bpmn:flowNodeRef>Task_ScheduleHearing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftIssueOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseArchive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Closed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Tier 2 user initiates filing" />
    <bpmn:task id="Task_SubmitFiling" name="Submit filing via public portal (PDF upload)" />
    <bpmn:task id="Task_AssignNumbers" name="Assign case &#38; docket number" />
    <bpmn:task id="Task_SendConfirmation" name="Send submission confirmation" />
    <bpmn:task id="Task_IntakeReview" name="Intake, validate &#38; record payment" />
    <bpmn:exclusiveGateway id="Gateway_ApproveDeny" name="Approve?">
      <bpmn:outgoing>Flow_0han8mk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_NotifyDenial" name="Notify filer of denial" />
    <bpmn:endEvent id="EndEvent_Denied" name="Filing denied" />
    <bpmn:task id="Task_JurisdictionalReview" name="Validate jurisdictional fit &#38; coordinate" />
    <bpmn:exclusiveGateway id="Gateway_Escalate" name="Escalate to Compliance?" />
    <bpmn:task id="Task_ScheduleHearing" name="Schedule hearing" />
    <bpmn:task id="Task_ReviewEvidence" name="Review evidence &#38; conduct hearing" />
    <bpmn:task id="Task_DraftIssueOrder" name="Draft &#38; issue order/decision" />
    <bpmn:exclusiveGateway id="Gateway_Merge" name="Case resolved" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_SubmitFiling" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SubmitFiling" targetRef="Task_AssignNumbers" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_AssignNumbers" targetRef="Task_SendConfirmation" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_SendConfirmation" targetRef="Task_IntakeReview" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_IntakeReview" targetRef="Gateway_ApproveDeny" />
    <bpmn:sequenceFlow id="Flow_06" name="Denied" sourceRef="Gateway_ApproveDeny" targetRef="Task_NotifyDenial" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_NotifyDenial" targetRef="EndEvent_Denied" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_RouteCase" targetRef="Task_JurisdictionalReview" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_JurisdictionalReview" targetRef="Gateway_Escalate" />
    <bpmn:sequenceFlow id="Flow_11" name="No — handle in Enforcement" sourceRef="Gateway_Escalate" targetRef="Task_LU_DraftOrder" />
    <bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="Gateway_Escalate" targetRef="Task_ScheduleHearing" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ScheduleHearing" targetRef="Task_ReviewEvidence" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ReviewEvidence" targetRef="Task_DraftIssueOrder" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_LU_DraftOrder" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_DraftIssueOrder" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_Merge" targetRef="Task_PublishStatus" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_PublishStatus" targetRef="Task_ManageCOS" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ManageCOS" targetRef="Task_CloseArchive" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_CloseArchive" targetRef="EndEvent_Closed" />
    <bpmn:task id="Task_RouteCase" name="Route case to division">
      <bpmn:incoming>Flow_0han8mk</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_0han8mk" name="Approved" sourceRef="Gateway_ApproveDeny" targetRef="Task_RouteCase" />
    <bpmn:task id="Task_LU_DraftOrder" name="Draft &#38; issue order (Enforcement)" />
    <bpmn:task id="Task_PublishStatus" name="Publish case status to portal" />
    <bpmn:task id="Task_ManageCOS" name="Manage notification list &#38; notify parties" />
    <bpmn:task id="Task_CloseArchive" name="Close &#38; archive case" />
    <bpmn:endEvent id="EndEvent_Closed" name="Case closed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
