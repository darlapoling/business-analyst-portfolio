<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PRCe360_NoLanes" targetNamespace="http://speridian.com/prce360" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.24.0">
  <bpmn:process id="Process_PRCe360_NoLanes" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Tier 2 user initiates filing" />
    <bpmn:task id="Task_SubmitFiling" name="Submit filing via public portal (PDF upload)" />
    <bpmn:task id="Task_AssignNumbers" name="Assign case &#38; docket number" />
    <bpmn:task id="Task_SendConfirmation" name="Send submission confirmation" />
    <bpmn:task id="Task_IntakeReview" name="Records: intake, validate &#38; record payment" />
    <bpmn:exclusiveGateway id="Gateway_ApproveDeny" name="Approve?" />
    <bpmn:task id="Task_NotifyDenial" name="Notify filer of denial" />
    <bpmn:endEvent id="EndEvent_Denied" name="Filing denied" />
    <bpmn:task id="Task_RouteCase" name="Route case to division" />
    <bpmn:task id="Task_JurisdictionalReview" name="Enforcement: validate jurisdictional fit &#38; coordinate" />
    <bpmn:exclusiveGateway id="Gateway_Escalate" name="Escalate to Compliance?" />
    <bpmn:task id="Task_LU_DraftOrder" name="Enforcement: draft &#38; issue order" />
    <bpmn:task id="Task_ScheduleHearing" name="Compliance: schedule hearing" />
    <bpmn:task id="Task_ReviewEvidence" name="Compliance: review evidence &#38; conduct hearing" />
    <bpmn:task id="Task_DraftIssueOrder" name="Compliance: draft &#38; issue order/decision" />
    <bpmn:exclusiveGateway id="Gateway_Merge" name="Case resolved" />
    <bpmn:task id="Task_PublishStatus" name="Publish case status to portal" />
    <bpmn:task id="Task_ManageCOS" name="Manage notification list &#38; notify parties" />
    <bpmn:task id="Task_CloseArchive" name="Close &#38; archive case" />
    <bpmn:endEvent id="EndEvent_Closed" name="Case closed" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_SubmitFiling" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SubmitFiling" targetRef="Task_AssignNumbers" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_AssignNumbers" targetRef="Task_SendConfirmation" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_SendConfirmation" targetRef="Task_IntakeReview" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_IntakeReview" targetRef="Gateway_ApproveDeny" />
    <bpmn:sequenceFlow id="Flow_06" name="Denied" sourceRef="Gateway_ApproveDeny" targetRef="Task_NotifyDenial" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_NotifyDenial" targetRef="EndEvent_Denied" />
    <bpmn:sequenceFlow id="Flow_08" name="Approved" sourceRef="Gateway_ApproveDeny" targetRef="Task_RouteCase" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_RouteCase" targetRef="Task_JurisdictionalReview" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_JurisdictionalReview" targetRef="Gateway_Escalate" />
    <bpmn:sequenceFlow id="Flow_11" name="No, handle in Enforcement" sourceRef="Gateway_Escalate" targetRef="Task_LU_DraftOrder" />
    <bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="Gateway_Escalate" targetRef="Task_ScheduleHearing" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ScheduleHearing" targetRef="Task_ReviewEvidence" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ReviewEvidence" targetRef="Task_DraftIssueOrder" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_LU_DraftOrder" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_DraftIssueOrder" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_Merge" targetRef="Task_PublishStatus" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_PublishStatus" targetRef="Task_ManageCOS" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ManageCOS" targetRef="Task_CloseArchive" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_CloseArchive" targetRef="EndEvent_Closed" />
  </bpmn:process>
